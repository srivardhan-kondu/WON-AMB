# Native Caddy in front of the Node app (sudo cp Caddyfile /etc/caddy/Caddyfile). Set WON_DOMAIN in Caddy's environment, or replace {$WON_DOMAIN} with the domain.
{$WON_DOMAIN} {
	encode zstd gzip

	# Runsheet live stream: no buffering, long-lived.
	@sse path /api/runsheet/stream
	reverse_proxy @sse 127.0.0.1:3000 {
		flush_interval -1
	}

	reverse_proxy 127.0.0.1:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}
}
